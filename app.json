{
  "expo": {
    "name": "Todo App",
    "slug": "todo-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/todo-logo.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/todo-logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.readyme.todoapp"
    },

    "web": {
      "bundler": "metro",
      "favicon": "./assets/todo-logo.png"
    },

    "plugins": [
      "expo-status-bar",
      "@react-native-community/datetimepicker"
    ],

    "extra": {
      "eas": {
        "projectId": "f7bd7f6b-fa39-42f6-bc12-6a53e81d48c3"
      }
    },

    "owner": "readyme"
  }
}